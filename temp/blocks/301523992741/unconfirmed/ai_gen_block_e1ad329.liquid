{% doc %}
  @prompt
    Create a delivery estimate block inside the product information section on the product page. The block should display an estimated delivery date range (e.g., "Estimated delivery: Aug 7 – Aug 10") based on the current date, with configurable lead time settings. It should be styled to match the product page and appear below the product title or description in the product information area.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-delivery-estimate-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
  }

  .ai-delivery-estimate__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-delivery-estimate__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-delivery-estimate__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-delivery-estimate__content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-delivery-estimate__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    color: {{ block.settings.label_color }};
    margin: 0 0 4px 0;
  }

  .ai-delivery-estimate__dates-{{ ai_gen_id }} {
    font-size: {{ block.settings.dates_font_size }}px;
    font-weight: {{ block.settings.dates_font_weight }};
    color: {{ block.settings.dates_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-delivery-estimate__container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.8 }}px;
    }

    .ai-delivery-estimate__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-delivery-estimate__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
    }

    .ai-delivery-estimate__dates-{{ ai_gen_id }} {
      font-size: {{ block.settings.dates_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<delivery-estimate-{{ ai_gen_id }}
  class="ai-delivery-estimate-{{ ai_gen_id }}"
  data-min-days="{{ block.settings.min_delivery_days }}"
  data-max-days="{{ block.settings.max_delivery_days }}"
  data-date-format="{{ block.settings.date_format }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-delivery-estimate__container-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-delivery-estimate__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
      </div>
    {% endif %}
    <div class="ai-delivery-estimate__content-{{ ai_gen_id }}">
      <p class="ai-delivery-estimate__label-{{ ai_gen_id }}">{{ block.settings.label_text }}</p>
      <p class="ai-delivery-estimate__dates-{{ ai_gen_id }}">
        <span class="ai-delivery-estimate__start-date-{{ ai_gen_id }}"></span>
        <span class="ai-delivery-estimate__separator-{{ ai_gen_id }}"> – </span>
        <span class="ai-delivery-estimate__end-date-{{ ai_gen_id }}"></span>
      </p>
    </div>
  </div>
</delivery-estimate-{{ ai_gen_id }}>

<script>
  (function() {
    class DeliveryEstimate{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.minDays = parseInt(this.dataset.minDays) || 3;
        this.maxDays = parseInt(this.dataset.maxDays) || 7;
        this.dateFormat = this.dataset.dateFormat || 'short';
      }

      connectedCallback() {
        this.calculateDeliveryDates();
      }

      calculateDeliveryDates() {
        const today = new Date();
        const startDate = new Date(today);
        const endDate = new Date(today);

        startDate.setDate(today.getDate() + this.minDays);
        endDate.setDate(today.getDate() + this.maxDays);

        const formatOptions = this.getFormatOptions();
        const formattedStartDate = startDate.toLocaleDateString('en-US', formatOptions);
        const formattedEndDate = endDate.toLocaleDateString('en-US', formatOptions);

        const startDateElement = this.querySelector('.ai-delivery-estimate__start-date-{{ ai_gen_id }}');
        const endDateElement = this.querySelector('.ai-delivery-estimate__end-date-{{ ai_gen_id }}');

        if (startDateElement) {
          startDateElement.textContent = formattedStartDate;
        }
        if (endDateElement) {
          endDateElement.textContent = formattedEndDate;
        }
      }

      getFormatOptions() {
        if (this.dateFormat === 'long') {
          return { month: 'long', day: 'numeric' };
        } else if (this.dateFormat === 'numeric') {
          return { month: 'numeric', day: 'numeric' };
        } else {
          return { month: 'short', day: 'numeric' };
        }
      }
    }

    customElements.define('delivery-estimate-{{ ai_gen_id }}', DeliveryEstimate{{ ai_gen_id }});
  })();
</script>

