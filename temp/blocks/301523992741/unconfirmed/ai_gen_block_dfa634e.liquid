{% doc %}
  @prompt
    Create a delivery estimate block for a product page that shows estimated delivery date range based on current date. Include a shipping icon, a message like "Estimated Delivery: Aug 7 - Aug 10", configurable lead days (min and max) in block settings, and styling that matches the store theme. Should be mobile-friendly and display inline near the Add to Cart button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-delivery-estimate-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-delivery-estimate__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
  }

  .ai-delivery-estimate__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-delivery-estimate__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-delivery-estimate__text-{{ ai_gen_id }} {
    flex-grow: 1;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
  }

  .ai-delivery-estimate__label-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-delivery-estimate__dates-{{ ai_gen_id }} {
    font-weight: 400;
  }

  @media screen and (max-width: 749px) {
    .ai-delivery-estimate-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-delivery-estimate__container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.8 }}px;
    }

    .ai-delivery-estimate__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-delivery-estimate__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<delivery-estimate-{{ ai_gen_id }}
  class="ai-delivery-estimate-{{ ai_gen_id }}"
  data-min-days="{{ block.settings.min_lead_days }}"
  data-max-days="{{ block.settings.max_lead_days }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-delivery-estimate__container-{{ ai_gen_id }}">
    <div class="ai-delivery-estimate__icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <div class="ai-delivery-estimate__text-{{ ai_gen_id }}">
      <span class="ai-delivery-estimate__label-{{ ai_gen_id }}">{{ block.settings.label_text }}</span>
      <span class="ai-delivery-estimate__dates-{{ ai_gen_id }}"></span>
    </div>
  </div>
</delivery-estimate-{{ ai_gen_id }}>

<script>
  (function() {
    class DeliveryEstimate{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.minDays = parseInt(this.dataset.minDays, 10);
        this.maxDays = parseInt(this.dataset.maxDays, 10);
        this.datesElement = this.querySelector('.ai-delivery-estimate__dates-{{ ai_gen_id }}');
        this.calculateDeliveryDates();
      }

      calculateDeliveryDates() {
        const today = new Date();
        const minDate = new Date(today);
        const maxDate = new Date(today);

        minDate.setDate(today.getDate() + this.minDays);
        maxDate.setDate(today.getDate() + this.maxDays);

        const formatOptions = { month: 'short', day: 'numeric' };
        const minFormatted = minDate.toLocaleDateString('en-US', formatOptions);
        const maxFormatted = maxDate.toLocaleDateString('en-US', formatOptions);

        this.datesElement.textContent = minFormatted + ' - ' + maxFormatted;
      }
    }

    customElements.define('delivery-estimate-{{ ai_gen_id }}', DeliveryEstimate{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Delivery estimate",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Estimated Delivery:"
    },
    {
      "type": "range",
      "id": "min_lead_days",
      "label": "Minimum lead days",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 4
    },
    {
      "type": "range",
      "id": "max_lead_days",
      "label": "Maximum lead days",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "d",
      "default": 7
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1f1f21"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#e3fc02"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Delivery estimate"
    }
  ]
}
{% endschema %}
