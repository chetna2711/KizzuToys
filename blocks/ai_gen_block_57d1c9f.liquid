{% doc %}
  @prompt
    Create a delivery estimate block inside the product information section on the product page. The block should display an estimated delivery date range (e.g., "Estimated delivery: Aug 7 – Aug 10") based on the current date, with configurable lead time settings. It should be styled to match the product page and appear below the product title or description in the product information area.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-delivery-estimate-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    {% if block.settings.show_border %}
      border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

 .ai-delivery-estimate__icon-wrapper-{{ ai_gen_id }} {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: flex-end;
  flex-wrap: nowrap;
}


  .ai-delivery-estimate__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-delivery-estimate__content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-delivery-estimate__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    color: {{ block.settings.label_color }};
    margin: 0 0 4px 0;
    white-space: nowrap;
  }

  .ai-delivery-estimate__dates-{{ ai_gen_id }} {
    font-size: {{ block.settings.dates_font_size }}px;
    font-weight: {{ block.settings.dates_font_weight }};
    color: {{ block.settings.dates_color }};
    margin: 0;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-delivery-estimate-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.8 }}px;
    }

    .ai-delivery-estimate__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-delivery-estimate__label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
    }

    .ai-delivery-estimate__dates-{{ ai_gen_id }} {
      font-size: {{ block.settings.dates_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<delivery-estimate-{{ ai_gen_id }} class="ai-delivery-estimate-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-delivery-estimate__icon-wrapper-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <svg class="ai-delivery-estimate__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    {% endif %}
    <div class="ai-delivery-estimate__content-{{ ai_gen_id }}">
  <span class="ai-delivery-estimate__label-{{ ai_gen_id }}">{{ block.settings.label_text }}</span>
  <span class="ai-delivery-estimate__dates-{{ ai_gen_id }}" data-delivery-estimate></span>
</div>

  </div>
</delivery-estimate-{{ ai_gen_id }}>

<script>
  (function() {
    class DeliveryEstimate{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.minDays = {{ block.settings.min_delivery_days }};
        this.maxDays = {{ block.settings.max_delivery_days }};
        this.dateFormat = '{{ block.settings.date_format }}';
        this.excludeWeekends = {{ block.settings.exclude_weekends }};
      }

      connectedCallback() {
        this.calculateDeliveryDates();
      }

      calculateDeliveryDates() {
        const today = new Date();
        const startDate = this.addBusinessDays(today, this.minDays);
        const endDate = this.addBusinessDays(today, this.maxDays);

        const formattedStart = this.formatDate(startDate);
        const formattedEnd = this.formatDate(endDate);

        const dateElement = this.querySelector('[data-delivery-estimate]');
        if (dateElement) {
          dateElement.textContent = `${formattedStart} – ${formattedEnd}`;
        }
      }

      addBusinessDays(date, days) {
        let currentDate = new Date(date);
        let addedDays = 0;

        while (addedDays < days) {
          currentDate.setDate(currentDate.getDate() + 1);
          
          if (this.excludeWeekends) {
            const dayOfWeek = currentDate.getDay();
            if (dayOfWeek !== 0 && dayOfWeek !== 6) {
              addedDays++;
            }
          } else {
            addedDays++;
          }
        }

        return currentDate;
      }

      formatDate(date) {
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const monthsFull = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        
        const day = date.getDate();
        const month = date.getMonth();
        const year = date.getFullYear();

        if (this.dateFormat === 'short') {
          return `${months[month]} ${day}`;
        } else if (this.dateFormat === 'long') {
          return `${monthsFull[month]} ${day}, ${year}`;
        } else {
          return `${day}/${month + 1}/${year}`;
        }
      }
    }

    customElements.define('delivery-estimate-{{ ai_gen_id }}', DeliveryEstimate{{ ai_gen_id }});
  })();
</script>

